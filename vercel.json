{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/xy-vms",
      "schedule": "0 4 * * *"
    }
  ],
  "regions": [
    "dub1"
  ],
  "git": {
    "deploymentEnabled": {
      "master": true,
      "preview/**": true,
      "qa/**": true,
      "release/**": true,
      "staging": true,
      "*": false
    }
  },
  "ignoreCommand": "node scripts/vercel-build-gate.mjs"
}
