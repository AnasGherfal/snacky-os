# APPLICATION SERVER ONLY. Never use NEXT_PUBLIC_ for any archive credential.
# Defaults to off. Configure in preview first, then test before enabling in production.
SNACKY_PHOTO_ARCHIVE_READ_ENABLED=false
SNACKY_PHOTO_ARCHIVE_PROJECT_REF=
SNACKY_PHOTO_ARCHIVE_ACCOUNT_ID=
SNACKY_PHOTO_ARCHIVE_BUCKET=snacky-photo-archive
# R2 Object Read ONLY, limited to the private archive bucket:
SNACKY_PHOTO_ARCHIVE_ACCESS_KEY_ID=
SNACKY_PHOTO_ARCHIVE_SECRET_ACCESS_KEY=

# COPY RUNNER ONLY. Do not install write credentials on the application server.
# R2 Object Read & Write, limited to the same private bucket; no public access.
SNACKY_PHOTO_ARCHIVE_WRITE_ACCESS_KEY_ID=
SNACKY_PHOTO_ARCHIVE_WRITE_SECRET_ACCESS_KEY=
# Runner also needs the existing source URL and server-only service key.
# The implemented source adapter uses ONLY HEAD and GET with these credentials.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
