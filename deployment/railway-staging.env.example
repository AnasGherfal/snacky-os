# Non-production Railway staging variable checklist
# DO NOT put real credentials in this file or commit a populated copy.
# First deployment should use no credentials and expose /api/migration-health only.
#
# Build-time: NEXT_PUBLIC_ variables become part of the Next.js browser bundle.
# Set only values belonging to a future ISOLATED staging Supabase project.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_APP_URL=
#
# Keep unset until an isolated staging database and owner approval:
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_URL=
# XY_VMS_BASE_URL=
# XY_VMS_MERCHANT_ID=
# XY_VMS_KEY=
# XY_VMS_SECRET=
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=
# BLOB_READ_WRITE_TOKEN=
#
# Explicit safety defaults for future staging:
XY_VMS_ENABLED=false
XY_WEB_ENABLED=false
XY_WEB_LIVE_SALES_ENABLED=false
SNACKY_PHOTO_ARCHIVE_MIGRATION_ENABLED=false
SNACKY_PHOTO_ARCHIVE_RELEASE_ENABLED=false
SNACKY_OLD_PHOTO_PURGE_ENABLED=false
SNACKY_ARCHIVE_60DAY_POLICY_ENABLED=false
SNACKY_MIGRATION_STAGING=true
