# Supabase Project Settings > API.
# Codex Secrets should be mapped to these canonical runtime names.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-secret-key
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# Public browser-safe aliases used by Next.js client/server code.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Compatibility aliases accepted by finance diagnostics when Codex/workspace secrets use older names.
SUPABASE_SERVICE_KEY=your-supabase-service-role-or-secret-key
POSTGRES_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# Public app origin used for metadata, auth URLs, and deployment checks.
NEXT_PUBLIC_APP_URL=https://your-vercel-domain.example

# Web Push notifications.
# Generate one VAPID key pair and keep the private key server-only.
# Example: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:admin@your-domain.example
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Server-only keys are required for creating/resetting Supabase Auth users from the Team screens.
# Never expose these in browser code, docs, commits, screenshots, or mobile clients.

# Optional server-side receipt OCR/AI. Leave blank to keep manual purchase entry enabled.
# Never prefix AI keys with NEXT_PUBLIC.
OPENAI_API_KEY=
RECEIPT_SCAN_MODEL=gpt-4.1-mini

# Optional UI locale. Supported values: en, ar.
NEXT_PUBLIC_APP_LOCALE=en

# XY/Xingyuan VMS API. Server-side only: never prefix these with NEXT_PUBLIC.
XY_VMS_ENABLED=true
XY_VMS_BASE_URL=https://xcx.xynetweb.com/service-api/api
XY_VMS_MERCHANT_ID=6591
XY_VMS_KEY=
XY_VMS_SECRET=
# Set to unsigned only if XY confirms key/sign/timestamp are not required in the JSON body.
XY_VMS_SIGNING_MODE=signed
XY_VMS_TIMEOUT_MS=20000

# XY/Xingyuan web dashboard API fallback. Server-side only; never prefix these with NEXT_PUBLIC.
XY_WEB_API_BASE_URL=https://xcx.xynetweb.com/sram
XY_WEB_API_AUTHORIZATION=
XY_WEB_MERCHANT_ID=6591
XY_WEB_LANGUAGE=en
XY_WEB_CHANNEL=1
XY_WEB_ENABLED=true
