# Public browser-safe values from Supabase Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Public app origin used for metadata, auth URLs, and deployment checks.
NEXT_PUBLIC_APP_URL=https://your-vercel-domain.example

# Server-only key. Required for creating/resetting Supabase Auth users from the Team screens.
# Never expose this in browser code, docs, commits, screenshots, or mobile clients.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-secret-key

# Optional UI locale. Supported values: en, ar.
NEXT_PUBLIC_APP_LOCALE=en

# XY/Xingyuan VMS API. Server-side only: never prefix these with NEXT_PUBLIC.
XY_VMS_ENABLED=true
XY_VMS_BASE_URL=http://175.6.71.238:8090/service-api/api
XY_VMS_MERCHANT_ID=
XY_VMS_KEY=
XY_VMS_SECRET=
# Set to unsigned only if XY confirms key/secret/sign/timestamp are not required in the JSON body.
XY_VMS_SIGNING_MODE=signed
XY_VMS_TIMEOUT_MS=30000
